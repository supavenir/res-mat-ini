{{> /include/header}}
{{> /include/bloc-header}}
<section class="form-page">
<form class="form-card"
      action="{{#edition}}/types-materiel/{{typeMateriel.id}}{{/edition}}{{^edition}}/types-materiel{{/edition}}"
      method="post">

        <p class="form-intro">
            {{#edition}}Modifiez les informations de ce type de matériel.{{/edition}}
            {{^edition}}Renseignez les informations du nouveau type de matériel.{{/edition}}
        </p>

    <div class="form-grid">
        <div class="form-group form-group-full">
            <label for="nom">Nom <span aria-hidden="true">*</span></label>
            <input
                id="nom"
                name="nom"
                type="text"
                maxlength="150"
                required
                value="{{typeMateriel.nom}}"
                placeholder="Ex. Ordinateur portable"
            >
        </div>

        <div class="form-group form-group-full">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="65000"
                rows="5"
                placeholder="Décrivez ce type de matériel"
            >{{typeMateriel.description}}</textarea>
        </div>

        <div class="form-group">
            <label for="dureeMaxEmprunt">Durée maximale d’emprunt (jours)</label>
            <input
                id="dureeMaxEmprunt"
                name="dureeMaxEmprunt"
                type="number"
                min="0"
                step="1"
                required
                value="{{typeMateriel.dureeMaxEmprunt}}"
            >
        </div>

        <div class="form-group">
            <label for="categorieId">Catégorie <span aria-hidden="true">*</span></label>
            <select id="categorieId" name="categorieId" required>
                <option value="">Choisir une catégorie</option>
                {{#categories}}
                    <option value="{{id}}"
                        {{#selected}}selected{{/selected}}>
                        {{nom}}
                    </option>
                {{/categories}}
            </select>
        </div>

        <div class="form-group form-group-full">
            <label class="checkbox-label" for="auCatalogue">
                <input
                    id="auCatalogue"
                    name="auCatalogue"
                    type="checkbox"
                    value="true"
                    {{#typeMateriel.auCatalogue}}checked{{/typeMateriel.auCatalogue}}
                >
                Afficher au catalogue
            </label>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit">
            {{#edition}}Enregistrer les modifications{{/edition}}
            {{^edition}}Créer le type de matériel{{/edition}}
        </button>
        <a class="button button-secondary" href="/types-materiel">
            Annuler
        </a>
    </div>
</form>
</section>
{{> /include/footer}}